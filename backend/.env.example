# Backend Environment Configuration
PROJECT_NAME="LifeSync AI"
API_V1_STR="/api/v1"

# Database Settings
POSTGRES_USER=lifesync
POSTGRES_PASSWORD=lifesyncpassword
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_DB=lifesync_db
# DATABASE_URL=sqlite:///./lifesync.db

# JWT & Authentication
SECRET_KEY=supersecretkey_please_change_in_production
JWT_SECRET=supersecretkey_please_change_in_production
ACCESS_TOKEN_MINUTES=15
REFRESH_DAYS=30
COOKIE_SECURE=false

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Email Settings
